diff --git a/src/lib/ledger/ledger.ts b/src/lib/ledger/ledger.ts
new file mode 100644
index 0000000..d41ced3
--- /dev/null
+++ b/src/lib/ledger/ledger.ts
@@ -0,0 +1,210 @@
+/**
+ * Ledger de ejecuciones ΓÇö fuente ├║nica de verdad del P&L.
+ *
+ * Reglas (ver audit/formulas.md):
+ *  - Toda cifra monetaria se calcula con Decimal (sin aritm├⌐tica binaria).
+ *  - Un snapshot se reconstruye siempre desde las ejecuciones.
+ *  - Valores vac├¡os / no num├⌐ricos NUNCA se convierten en 0: se rechazan.
+ *  - Las salidas no pueden superar a las entradas (sin reversi├│n impl├¡cita).
+ *  - Asignaci├│n de costo de entrada: FIFO.
+ *  - Cada fee se descuenta exactamente una vez.
+ */
+import Decimal from "decimal.js";
+
+export const CALCULATION_VERSION = "ledger-1.0.0";
+
+export type Side = "BUY" | "SELL";
+export type Direction = "LONG" | "SHORT";
+export type TradeStatus = "OPEN" | "PARTIALLY_CLOSED" | "CLOSED";
+export type EconomicResult = "WIN" | "LOSS" | "NET_BREAKEVEN";
+
+export interface FeeComponent {
+  type: "COMMISSION" | "EXCHANGE" | "CLEARING" | "REGULATORY" | "OTHER";
+  amount: Decimal;
+  currency: string;
+  source: "IMPORTED" | "ESTIMATED" | "MANUAL";
+  scheduleVersion?: string;
+}
+
+export interface Execution {
+  id: string;
+  side: Side;
+  quantity: Decimal;
+  price: Decimal;
+  executedAtUtc?: string;
+  fees: FeeComponent[];
+}
+
+export interface TradeSnapshot {
+  direction: Direction;
+  status: TradeStatus;
+  entryQuantity: Decimal;
+  exitQuantity: Decimal;
+  openQuantity: Decimal;
+  averageEntryPrice: Decimal | null;
+  averageExitPrice: Decimal | null;
+  realizedGrossPnl: Decimal;
+  /** Costes asignados a la cantidad efectivamente cerrada (entrada proporcional FIFO + salida). */
+  realizedFees: Decimal;
+  /** Costes totales devengados en todas las ejecuciones registradas (abiertas + cerradas). */
+  accruedFees: Decimal;
+  /** Costes de entrada remanentes en la posici├│n abierta (accruedFees - realizedFees). */
+  openFees: Decimal;
+  /** P&L neto realizado sobre los contratos cerrados (realizedGrossPnl - realizedFees). */
+  realizedNetPnl: Decimal;
+  /** P&L bruto realizado menos la totalidad de costes devengados (realizedGrossPnl - accruedFees). */
+  netPnlAfterAccruedFees: Decimal;
+  /** null salvo que exista un precio de mercado confiable (no se inventa). */
+  unrealizedGrossPnl: Decimal | null;
+  /** Solo definido cuando status === "CLOSED". */
+  economicResult: EconomicResult | null;
+  calculationVersion: string;
+}
+
+export class LedgerError extends Error {
+  constructor(public code: string, message: string) {
+    super(message);
+    this.name = "LedgerError";
+  }
+}
+
+/** Convierte una entrada de usuario a Decimal. Rechaza null, undefined, "", espacios, NaN e Infinity. */
+export function parseDecimalStrict(value: unknown, field: string): Decimal {
+  if (value === null || value === undefined) throw new LedgerError("MISSING_VALUE", `${field}: valor ausente`);
+  if (typeof value === "string" && value.trim() === "") throw new LedgerError("MISSING_VALUE", `${field}: valor vac├¡o`);
+  if (typeof value !== "string" && typeof value !== "number" && !(value instanceof Decimal)) {
+    throw new LedgerError("INVALID_VALUE", `${field}: tipo no v├ílido`);
+  }
+  let d: Decimal;
+  try {
+    d = new Decimal(typeof value === "string" ? value.trim() : value);
+  } catch {
+    throw new LedgerError("INVALID_VALUE", `${field}: n├║mero no v├ílido`);
+  }
+  if (!d.isFinite()) throw new LedgerError("INVALID_VALUE", `${field}: n├║mero no finito`);
+  return d;
+}
+
+function validateExecution(
+  e: Execution,
+  opts?: { allowZeroPrice?: boolean; allowNegativePrice?: boolean },
+) {
+  if (!e.quantity.isFinite() || e.quantity.lte(0)) {
+    throw new LedgerError("INVALID_QUANTITY", `Ejecuci├│n ${e.id}: la cantidad debe ser > 0`);
+  }
+  if (!e.price.isFinite()) {
+    throw new LedgerError("INVALID_PRICE", `Ejecuci├│n ${e.id}: el precio debe ser un n├║mero finito`);
+  }
+  if (e.price.eq(0) && !opts?.allowZeroPrice) {
+    throw new LedgerError("INVALID_PRICE", `Ejecuci├│n ${e.id}: el instrumento no admite precio igual a 0`);
+  }
+  if (e.price.lt(0) && !opts?.allowNegativePrice) {
+    throw new LedgerError("INVALID_PRICE", `Ejecuci├│n ${e.id}: el instrumento no admite precio negativo`);
+  }
+  for (const f of e.fees) {
+    if (!f.amount.isFinite() || f.amount.lt(0)) {
+      throw new LedgerError("INVALID_FEE", `Ejecuci├│n ${e.id}: fee no v├ílido`);
+    }
+  }
+}
+
+const sumFees = (e: Execution) => e.fees.reduce((s, f) => s.plus(f.amount), new Decimal(0));
+
+/**
+ * Reconstruye el snapshot de un trade desde sus ejecuciones.
+ * La direcci├│n la define la primera ejecuci├│n en orden cronol├│gico (orden del array).
+ */
+export function computeSnapshot(
+  executions: Execution[],
+  pointValue: Decimal,
+  priceOpts?: { allowZeroPrice?: boolean; allowNegativePrice?: boolean },
+): TradeSnapshot {
+  if (executions.length === 0) throw new LedgerError("NO_EXECUTIONS", "El trade no tiene ejecuciones");
+  if (!pointValue.isFinite() || pointValue.lte(0)) {
+    throw new LedgerError("UNKNOWN_SPEC", "Valor por punto desconocido o no v├ílido");
+  }
+  executions.forEach(e => validateExecution(e, priceOpts));
+
+  const openingSide = executions[0].side;
+  const direction: Direction = openingSide === "BUY" ? "LONG" : "SHORT";
+
+  // Lotes abiertos FIFO con fee de entrada remanente para asignaci├│n proporcional exacta (┬º9.2)
+  const lots: { qty: Decimal; price: Decimal; feeRemaining: Decimal }[] = [];
+  let entryQty = new Decimal(0);
+  let entryNotional = new Decimal(0);
+  let exitQty = new Decimal(0);
+  let exitNotional = new Decimal(0);
+  let gross = new Decimal(0);
+  let accruedFees = new Decimal(0);
+  let realizedFees = new Decimal(0);
+
+  for (const e of executions) {
+    const execFee = sumFees(e);
+    accruedFees = accruedFees.plus(execFee);
+    if (e.side === openingSide) {
+      lots.push({ qty: e.quantity, price: e.price, feeRemaining: execFee });
+      entryQty = entryQty.plus(e.quantity);
+      entryNotional = entryNotional.plus(e.quantity.mul(e.price));
+      continue;
+    }
+    const openQty = entryQty.minus(exitQty);
+    if (e.quantity.gt(openQty)) {
+      throw new LedgerError(
+        "EXIT_EXCEEDS_ENTRY",
+        `La salida (${e.quantity}) supera la cantidad abierta (${openQty}). Registra la reversi├│n como un trade separado.`,
+      );
+    }
+    let remaining = e.quantity;
+    while (remaining.gt(0)) {
+      const lot = lots[0];
+      const take = Decimal.min(lot.qty, remaining);
+      const diff = direction === "LONG" ? e.price.minus(lot.price) : lot.price.minus(e.price);
+      gross = gross.plus(take.mul(diff).mul(pointValue));
+      const allocatedEntryFee = take.eq(lot.qty)
+        ? lot.feeRemaining
+        : lot.feeRemaining.mul(take).div(lot.qty);
+      realizedFees = realizedFees.plus(allocatedEntryFee);
+      lot.feeRemaining = lot.feeRemaining.minus(allocatedEntryFee);
+      lot.qty = lot.qty.minus(take);
+      remaining = remaining.minus(take);
+      if (lot.qty.eq(0)) lots.shift();
+    }
+    realizedFees = realizedFees.plus(execFee);
+    exitQty = exitQty.plus(e.quantity);
+    exitNotional = exitNotional.plus(e.quantity.mul(e.price));
+  }
+
+  const openQuantity = entryQty.minus(exitQty);
+  const status: TradeStatus = exitQty.eq(0) ? "OPEN" : openQuantity.gt(0) ? "PARTIALLY_CLOSED" : "CLOSED";
+  const openFees = accruedFees.minus(realizedFees);
+  const net = gross.minus(realizedFees);
+  const netAfterAccrued = gross.minus(accruedFees);
+  const economicResult: EconomicResult | null =
+    status !== "CLOSED" ? null : net.gt(0) ? "WIN" : net.lt(0) ? "LOSS" : "NET_BREAKEVEN";
+
+  return {
+    direction,
+    status,
+    entryQuantity: entryQty,
+    exitQuantity: exitQty,
+    openQuantity,
+    averageEntryPrice: entryQty.gt(0) ? entryNotional.div(entryQty) : null,
+    averageExitPrice: exitQty.gt(0) ? exitNotional.div(exitQty) : null,
+    realizedGrossPnl: gross,
+    realizedFees,
+    accruedFees,
+    openFees,
+    realizedNetPnl: net,
+    netPnlAfterAccruedFees: netAfterAccrued,
+    unrealizedGrossPnl: null,
+    economicResult,
+    calculationVersion: CALCULATION_VERSION,
+  };
+}
+
+/** Fee de comisi├│n por lado y contrato, marcado como ESTIMADO (no importado del broker). */
+export function estimatedCommission(perSidePerContract: Decimal, quantity: Decimal, scheduleVersion?: string): FeeComponent[] {
+  const amount = perSidePerContract.mul(quantity);
+  if (amount.eq(0)) return [];
+  return [{ type: "COMMISSION", amount, currency: "USD", source: "ESTIMATED", scheduleVersion }];
+}
