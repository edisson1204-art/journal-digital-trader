# Variables de entorno requeridas (valores ficticios de ejemplo — NO usar en producción)
NEXT_PUBLIC_SUPABASE_URL=https://example-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_server_only_here
SYSTEME_WEBHOOK_SECRET=replace_with_32_byte_random_hex_secret

# Opcional: variables para ejecutar audit/verify_staging_rls.mjs contra un proyecto Supabase de staging aislado
STAGING_SUPABASE_URL=https://staging-project-ref.supabase.co
STAGING_SUPABASE_ANON_KEY=your_staging_supabase_anon_key_here
STAGING_USER_A_EMAIL=audit_user_a@example.test
STAGING_USER_A_PASSWORD=ChangeMe_Staging_UserA_123!
STAGING_USER_B_EMAIL=audit_user_b@example.test
STAGING_USER_B_PASSWORD=ChangeMe_Staging_UserB_123!
